{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livemarket-ms-media",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "livemarket-media-prod"
    }
  ]
}